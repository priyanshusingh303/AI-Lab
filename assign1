from matplotlib import colors
import matplotlib.pyplot as plt
epochs=[1,2,3,4,5]
train_acc=[60,70,80,82,95]
hardware=["cpu","gpu","tpu"]
fps=[30,75,128]
plt.figure(figsize=(12,5))
plt.subplot(1,2,1)
plt.plot(epochs,train_acc,marker='o',color='green',linewidth=2,label='Training Accuracy')
plt.title('training over epochs')
plt.xlabel('epochs')
plt.ylabel('training acc')
plt.grid(True)
plt.legend()

plt.subplot(1,2,2)
plt.plot(hardware,fps,marker='o',color='blue',linewidth=2,label='Performance')
plt.title('Device v FPS')
plt.xlabel('Device')
plt.ylabel('FPS')
plt.grid(True)
plt.legend()

plt.show()
